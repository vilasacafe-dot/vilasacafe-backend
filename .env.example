# ============================================================
# Vilasa Cafe — BACKEND environment (.env)
# ALL values here are SECRET. Never commit the real .env and
# never expose these to the React frontend.
# ============================================================

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (your frontend URL[s]).
CORS_ORIGINS=http://localhost:5173

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# The Vilasa Cafe restaurant row id (from 010_seed.sql).
VILASA_RESTAURANT_ID=11111111-1111-1111-1111-111111111111

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Public base URL for the bucket (custom domain or the r2.dev URL). No trailing slash.
R2_PUBLIC_URL=https://your-public-bucket-url

# Uploads
MAX_UPLOAD_BYTES=8388608
